+        Request::Jvp {
+            parameters,
+            direction,
+        } => Ok(crate::differentiation::jvp(model, parameters, direction)?.to_json()),
+        Request::Vjp {
+            parameters,
+            selection,
+            cotangents,
+        } => Ok(serde_json::to_value(crate::differentiation::vjp(
